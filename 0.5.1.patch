+def test_a_failed_install_disarms_the_timer(guard):
+    def bad(args, stdin):
+        return 1, "", "Error: nope"
+    fs = FloorSync(NftSets(run=bad), log=lambda m: None, resolv=lambda: [], protect=lambda: {}, guard=guard)
+    with pytest.raises(FirewallError):
