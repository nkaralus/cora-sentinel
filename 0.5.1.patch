+    with pytest.raises(FloorRefused) as e:
+        fs.apply(bl_with(["192.168.1.0/24"]))
+    assert "192.168.1.50" in str(e.value) and "192.168.1.0/24" in str(e.value) and "--floor-allow" in str(e.value)
+    assert f.scripts == []
