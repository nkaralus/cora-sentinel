+# /etc/cora-sentinel/cora-sentinel.conf  (read by the unit as an EnvironmentFile)
+#
+# One CORA_ARGS line, split on whitespace. systemd does no shell quoting here, so no spaces inside a value.
+# Run `cora-sentinel --help` for every flag. Changes here apply on `systemctl restart cora-sentinel`; edited
+# blocklist FILES apply on `systemctl reload cora-sentinel` (a SIGHUP, no restart, no detection gap).
+#
+# What is on below:
+#   --floor --floor-confirm 120   kernel-side drop of listed addresses, with a dead-man: after the FIRST start (and
+#                                 whenever the floor's allow set changes) run `sudo cora-floor confirm` within 120 s
+#                                 or the floor removes itself. Restarts with an unchanged allow set do not ask again.
+#
+# Add (keep it all on the one line):
+#   --blocklist /etc/cora-sentinel/blocklists --blocklist-allow /etc/cora-sentinel/allow
+#   --floor-allow 192.168.0.0/16   your LAN, always accepted by the floor
+#   --floor-allow-detected         allow the default gateway and live SSH peers instead of refusing
+#   --model /var/lib/cora-sentinel/models/model.gguf   (and later --enforce, once you trust it)
+CORA_ARGS=--cgroup-root /sys/fs/cgroup/cora --nft --nflog --floor --floor-confirm 120 --out /var/log/cora-sentinel/events.jsonl --decisions /var/log/cora-sentinel/decisions.jsonl --report-dir /var/lib/cora-sentinel/reports
diff --git a/deploy/cora-sentinel.service b/deploy/cora-sentinel.service
new file mode 100644
index 0000000..99608df
--- /dev/null
+++ b/deploy/cora-sentinel.service
@@ -0,0 +1,50 @@
+# cora-sentinel.service
+#
+# Installed by deploy/install-service.sh, which fills in @BINDIR@ (where `cora-sentinel` and `cora-floor` live,
+# e.g. /opt/cora-sentinel/venv/bin). Arguments come from /etc/cora-sentinel/cora-sentinel.conf, so you edit that file
+# and not this one.
+#
+# Lifecycle, on purpose:
+#   * Restart=on-failure, capped (5 starts in 5 minutes), so a refused config does not spin forever.
+#   * The kernel floor OUTLIVES the service. Stopping, restarting or crashing the daemon leaves a CONFIRMED floor
+#     in place (that is the point of a floor). Only an UNCONFIRMED floor is removed on stop (ExecStopPost), because
+#     nobody has vouched for it yet. `cora-floor remove` or `cora-firewall purge` takes a confirmed one out.
+#   * Per-task ISOLATE rules and task cgroups also stay, as they do without systemd.
+
+[Unit]
+Description=cora-sentinel: out-of-band task sentinel (cgroups, nftables, NFLOG tap, kernel blocklist floor)
+Documentation=https://github.com/nkaralus/cora-sentinel
+Wants=network-online.target
+# nftables.service, if you use it, loads /etc/nftables.conf (often starting with `flush ruleset`). Start after it so
+# it cannot wipe the floor at boot.
+After=network-online.target nftables.service
+StartLimitIntervalSec=300
+StartLimitBurst=5
+
+[Service]
+Type=simple
+EnvironmentFile=-/etc/cora-sentinel/cora-sentinel.conf
+ExecStart=@BINDIR@/cora-sentinel $CORA_ARGS
+# systemd kills the whole service cgroup on stop, including the floor's rollback watchdog. If the floor is still
+# unconfirmed, remove it now (a no-op once it is confirmed). The leading "-" ignores a failure.
+ExecStopPost=-@BINDIR@/cora-floor rollback
+# `systemctl reload cora-sentinel` re-reads the blocklists (SIGHUP); nothing else changes.
+ExecReload=/bin/kill -HUP $MAINPID
+Restart=on-failure
+RestartSec=5
+TimeoutStopSec=20
+KillSignal=SIGTERM
+
+# /var/lib/cora-sentinel (floor confirmation state, reports) and /var/log/cora-sentinel (events, decisions).
+StateDirectory=cora-sentinel
+StateDirectoryMode=0700
+LogsDirectory=cora-sentinel
+WorkingDirectory=/var/lib/cora-sentinel
+
+# Light hardening only: the daemon needs broad root powers (cgroups, nftables, netlink, killing tasks), so it is not
+# sandboxed further. Raise it yourself if your setup allows.
+NoNewPrivileges=yes
+ProtectSystem=full
+
+[Install]
+WantedBy=multi-user.target
diff --git a/deploy/install-service.sh b/deploy/install-service.sh
new file mode 100755
index 0000000..2013ac7
--- /dev/null
+++ b/deploy/install-service.sh
@@ -0,0 +1,66 @@
+#!/usr/bin/env bash
+# Install or remove the cora-sentinel systemd unit. It never enables or starts the service for you.
+#
+#   sudo deploy/install-service.sh [--bindir DIR]       install (default DIR: where `cora-sentinel` is on PATH)
+#   sudo deploy/install-service.sh --uninstall [--remove-floor]
+#
+# CORA_ROOT=/some/prefix installs under that prefix and skips systemctl (used by the tests).
+set -euo pipefail
+
+root="${CORA_ROOT:-}"
+unit_dir="$root/etc/systemd/system"
+conf_dir="$root/etc/cora-sentinel"
+here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+bindir="" mode=install remove_floor=no
+
+while [ $# -gt 0 ]; do
+  case "$1" in
+    --bindir) bindir="${2:?--bindir needs a directory}"; shift 2 ;;
+    --uninstall) mode=uninstall; shift ;;
+    --remove-floor) remove_floor=yes; shift ;;
+    -h|--help) sed -n '2,8p' "${BASH_SOURCE[0]}"; exit 0 ;;
+    *) echo "unknown option: $1" >&2; exit 2 ;;
+  esac
+done
+
+if [ -z "$root" ] && [ "$(id -u)" -ne 0 ]; then echo "run as root" >&2; exit 1; fi
+sc() { [ -n "$root" ] || systemctl "$@"; }
+
+if [ "$mode" = uninstall ]; then
+  sc disable --now cora-sentinel 2>/dev/null || true
+  rm -f "$unit_dir/cora-sentinel.service"
+  sc daemon-reload
+  if [ "$remove_floor" = yes ]; then
+    floor="$(command -v cora-floor || true)"
+    [ -n "$bindir" ] && floor="$bindir/cora-floor"
+    [ -n "$floor" ] && "$floor" remove || echo "cora-floor not found; remove the floor yourself" >&2
+  else
+    echo "The kernel floor is still in place if it was confirmed. Remove it with: cora-floor remove"
+  fi
+  echo "Unit removed. $conf_dir and /var/lib/cora-sentinel are left alone."
+  exit 0
+fi
+
+[ -n "$bindir" ] || bindir="$(dirname "$(command -v cora-sentinel || true)")"
+for exe in cora-sentinel cora-floor; do
+  [ -x "$bindir/$exe" ] || { echo "$bindir/$exe not found: pip install the package first, or pass --bindir" >&2; exit 1; }
+done
+bindir="$(cd "$bindir" && pwd)"
+
+install -d -m 0755 "$unit_dir" "$conf_dir"
+sed "s|@BINDIR@|$bindir|g" "$here/cora-sentinel.service" > "$unit_dir/cora-sentinel.service"
+chmod 0644 "$unit_dir/cora-sentinel.service"
+if [ -e "$conf_dir/cora-sentinel.conf" ]; then
+  echo "kept your existing $conf_dir/cora-sentinel.conf"
+else
+  install -m 0640 "$here/cora-sentinel.conf" "$conf_dir/cora-sentinel.conf"
+fi
+sc daemon-reload
+cat <<MSG
+Installed $unit_dir/cora-sentinel.service (binaries in $bindir).
+Next:
+  1. Edit $conf_dir/cora-sentinel.conf
+  2. systemctl enable --now cora-sentinel
+  3. cora-floor confirm        # within the --floor-confirm window, the first time (and when the allow set changes)
+  Logs: journalctl -u cora-sentinel -f
+MSG
