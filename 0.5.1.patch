+    mk = lambda extra: FloorSync(NftSets(run=FakeNft()), log=lambda m: None, resolv=lambda: [],   # noqa: E731
+                                 protect=lambda: {}, guard=guard, extra_allow=extra)
+    bl = bl_with(["203.0.113.0/24"])
+    a = mk(["192.168.0.0/16"])
+    a.start(bl, 60)
