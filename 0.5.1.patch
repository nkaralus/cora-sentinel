+def fsync(bl_log=None, **kw):
+    logs = [] if bl_log is None else bl_log
+    f = FakeNft()
+    kw.setdefault("protect", lambda: dict(PEER))
+    return FloorSync(NftSets(run=f), log=logs.append, resolv=lambda: [], **kw), f, logs
