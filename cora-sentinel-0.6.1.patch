+# /etc/logrotate.d/cora-sentinel  (installed by deploy/install-service.sh)
+#
+# The daemon keeps these files open for appending and never reopens them, so rotation must be copytruncate.
+# Size-based on purpose: `cora-floor dyn-report` reads the decision log, and a time-based rotation would cut a week of
+# shadow data at an arbitrary moment. To review across rotations:
+#     zcat -f /var/log/cora-sentinel/decisions.jsonl* | cora-floor dyn-report /dev/stdin
+/var/log/cora-sentinel/*.jsonl {
+    size 100M
+    rotate 10
+    compress
+    delaycompress
+    copytruncate
+    missingok
+    notifempty
+}
