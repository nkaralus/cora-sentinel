# The sdist is an explicit allow-list: the repository root also holds the superseded layouts (cora-os/, superseded-flat/, ...) and
# loose starter files that must not ship. tests/test_repo_root.py keeps new clutter (patches, zips, notes) out of the root.
include LICENSE README.md CHANGELOG.md pyproject.toml
recursive-include src/cora_sentinel/_vendor *.py *.json LICENSE NOTICE VENDOR.lock
recursive-include deploy *
recursive-include packaging *
recursive-include docs *.md
recursive-include tools *.py
recursive-include tests *.py
recursive-include tests/fixtures *
recursive-include examples *
recursive-include schema *
global-exclude __pycache__ *.pyc
