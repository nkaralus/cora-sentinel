+    d = run_queued(adj)
+    assert d["gate"]["ok"] and d["gate"]["code"] == "OK_PROCESS_GONE"
+    assert d["action"].startswith("done:ISOLATE@cgroup:task0") and fw.calls == ["task0"]
+    assert not registered(net, p.pid), "and the VIP is released afterwards"
