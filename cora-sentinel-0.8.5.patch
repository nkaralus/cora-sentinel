+# ---------------------------------------------------------------------------------------------- Adjudicator: pin on submit
+class IdCg(FakeCg):
+    """FakeCg that also knows each cgroup's identity (the inode the kernel gives it)."""
+    def __init__(self):
+        super().__init__()
+        self.ids = {}
+
+    def cgroup_id(self, name):
+        return self.ids.get(name)
+
