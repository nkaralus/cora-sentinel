-      - run: pip install -e ".[dev]"
-      - run: python -m pytest -q
+          cache: pip
+          cache-dependency-path: pyproject.toml
+      - name: install (no runtime dependencies; the dev extras are pytest and jsonschema)
+        run: python -m pip install -e ".[dev]"
+      - name: the vendored safety gate is exactly what VENDOR.lock says
+        run: python tools/vendor_bus.py check
+      - name: tests
+        run: python -m pytest -q -ra
 
   package:
     runs-on: ubuntu-latest
+    timeout-minutes: 20
     steps:
       - uses: actions/checkout@v4
       - uses: actions/setup-python@v5
         with:
           python-version: "3.12"
-      - run: pip install build
-      - run: python -m build
-      - run: pip install dist/*.whl
-      - run: cora-selfcheck || true   # reports machine capabilities; the runner is not expected to have them all
+          cache: pip
