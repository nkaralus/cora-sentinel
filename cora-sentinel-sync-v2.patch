+def test_no_rotation_behaves_like_v1(store, gh):
+    gh.publish(C1, {TRK: render("t", ["criteo.com"])}, ts=100, key=K1)
+    rc, log = go(store, gh)
+    assert rc == 0 and keys(store) is None
+    assert store.lock()["cora_sync"]["epoch"] == 0
