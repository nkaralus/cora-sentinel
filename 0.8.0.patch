@@ -0,0 +1,25 @@
+"""Error types. Every error carries a machine-readable `code`."""
+from __future__ import annotations
+
+from typing import Any
+
+
+def show(v: Any) -> str:
+    """Bounded, ASCII-only rendering of untrusted values for messages and logs."""
+    s = ascii(v)
+    return s if len(s) <= 48 else s[:45] + "..."
+
+
+class BusError(Exception):
+    def __init__(self, code: str, detail: str = ""):
+        super().__init__(f"{code}: {detail}" if detail else code)
+        self.code = code
+        self.detail = detail
+
+
+class RegistryError(BusError):
+    pass
+
+
+class PathError(BusError):
+    pass
diff --git a/src/cora_sentinel/_vendor/subnetbus/fsguard.py b/src/cora_sentinel/_vendor/subnetbus/fsguard.py
new file mode 100644
index 0000000..6865fd3
--- /dev/null
+++ b/src/cora_sentinel/_vendor/subnetbus/fsguard.py
@@ -0,0 +1,151 @@
+"""Filesystem guard (GI_3, filesystem half) and lexical path checks (GI_2).
+
+Two layers:
+  lexical_segments(p)  pure string check, no disk access. Used by GI_2.
+  PathGuard.check(p, op)  resolves against a project root and refuses symlinks,
+                          mountpoints, cross-device paths, root escapes, and
+                          project roots that are filesystem roots or system dirs.
+
+The guard is ADVISORY about the instant it ran. The harness must still open files
+with no-follow semantics and re-check the registry revision before committing.
+"""
+from __future__ import annotations
+
+import os
+import re
+from pathlib import Path
+from typing import Iterable, List, Optional
+
+from .errors import PathError, show
+
+__all__ = ["lexical_segments", "PathGuard", "active_mountpoints",
+           "READ_OPS", "WRITE_OPS", "DESTRUCTIVE_OPS"]
+
+READ_OPS = frozenset({"read", "stat", "list"})
+WRITE_OPS = frozenset({"write", "create", "overwrite", "chmod"})
+DESTRUCTIVE_OPS = frozenset({"delete", "rmdir", "move"})
+
+MAX_PATH_CHARS = 1024
+MAX_DEPTH = 32
+_SEGMENT = re.compile(r"[A-Za-z0-9_][A-Za-z0-9._-]{0,254}", re.ASCII)
+_RESERVED = frozenset({"con", "prn", "aux", "nul"}
+                      | {f"com{i}" for i in range(1, 10)} | {f"lpt{i}" for i in range(1, 10)})
+_SCHEMES = ("res://",)
+
+
+def lexical_segments(p: object) -> List[str]:
+    """Validate a project-relative path and return its segments. Raises PathError."""
+    if type(p) is not str:
+        raise PathError("PATH_TYPE", "path must be str")
+    if not p:
+        raise PathError("PATH_EMPTY")
+    if len(p) > MAX_PATH_CHARS:
+        raise PathError("PATH_TOO_LONG")
+    if not p.isascii():
+        raise PathError("PATH_NON_ASCII", show(p))
+    if not p.isprintable():
+        raise PathError("PATH_CONTROL_CHAR", show(p))
+    for s in _SCHEMES:
+        if p.startswith(s):
+            p = p[len(s):]
+            break
+    if ":" in p:
+        raise PathError("PATH_SCHEME", f"drive letters, URIs and ADS are not allowed: {show(p)}")
+    if "\\" in p:
+        raise PathError("PATH_BACKSLASH", show(p))
+    if p.startswith("/"):
+        raise PathError("PATH_ABSOLUTE", show(p))
+    segs = p.split("/")
+    if len(segs) > MAX_DEPTH:
+        raise PathError("PATH_TOO_DEEP")
+    for seg in segs:
+        if seg == "..":
+            raise PathError("PATH_TRAVERSAL", show(p))
+        if not _SEGMENT.fullmatch(seg) or seg.endswith("."):
+            raise PathError("PATH_SEGMENT", f"bad segment {show(seg)}")
+        if seg.split(".", 1)[0].casefold() in _RESERVED:
+            raise PathError("PATH_RESERVED_NAME", show(seg))
+    return segs
+
+
+def _unescape(s: str) -> str:
+    return re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), s)
+
+
+def active_mountpoints(mountinfo: str = "/proc/self/mountinfo") -> frozenset:
+    """Mount points of this process (Linux). Empty elsewhere; PathGuard then relies on
+    os.path.ismount and st_dev comparison per component."""
+    try:
+        text = Path(mountinfo).read_text(encoding="utf-8", errors="replace")
+    except OSError:
+        return frozenset()
+    out = set()
+    for line in text.splitlines():
+        parts = line.split(" ")
+        if len(parts) > 4:
+            out.add(_unescape(parts[4]))
+    return frozenset(out)
+
+
+_PROTECTED_EXACT = {"/", "/home", "/root", "/var", "/tmp", "/mnt", "/media", "/opt", "/srv"}
+_PROTECTED_TREES = ("/proc", "/sys", "/dev", "/boot", "/etc", "/bin", "/sbin", "/lib", "/lib64", "/usr")
+
+
+class PathGuard:
+    def __init__(self, root: "str | os.PathLike", *, mountpoints: Optional[Iterable[str]] = None,
+                 allow_symlinks: bool = False):
+        r = Path(root)
+        if not r.is_absolute():
+            raise PathError("ROOT_NOT_ABSOLUTE", show(str(root)))
+        real = Path(os.path.realpath(r))
+        if not real.is_dir():
+            raise PathError("ROOT_MISSING", show(str(real)))
+        if real == Path(real.anchor) or real.parent == real:
+            raise PathError("ROOT_IS_FS_ROOT", show(str(real)))
+        s = str(real)
+        if s in _PROTECTED_EXACT or real == Path.home() \
+                or any(s == t or s.startswith(t + "/") for t in _PROTECTED_TREES):
+            raise PathError("ROOT_PROTECTED", show(s))
+        sysroot = os.environ.get("SystemRoot")
+        if sysroot and (real == Path(sysroot) or Path(sysroot) in real.parents):
+            raise PathError("ROOT_PROTECTED", show(s))
+        self.root = real
+        self.allow_symlinks = allow_symlinks
+        mounts = active_mountpoints() if mountpoints is None else mountpoints
+        self._mounts = frozenset(os.path.realpath(m) for m in mounts)
+        self._root_dev = os.stat(real).st_dev
+
+    def _mount_inside(self, s: str) -> Optional[str]:
+        pre = s.rstrip(os.sep) + os.sep
+        return next((m for m in self._mounts if m.startswith(pre)), None)
+
+    def check(self, rel: object, op: object) -> Path:
+        """Return the resolved path if `op` on `rel` is safe. Raises PathError."""
+        if op not in READ_OPS | WRITE_OPS | DESTRUCTIVE_OPS:
+            raise PathError("UNKNOWN_FS_OP", show(op))
+        cur = self.root
+        for seg in lexical_segments(rel):
+            cur = cur / seg
+            s = str(cur)
+            if s in self._mounts or os.path.ismount(s):
+                raise PathError("MOUNTPOINT", show(s))
+            if os.path.islink(s) and not self.allow_symlinks:
+                raise PathError("SYMLINK", show(s))
+            try:
+                st = os.lstat(s)
+            except FileNotFoundError:
+                continue
+            except OSError as e:
+                raise PathError("FS_ERROR", type(e).__name__) from None
+            if st.st_dev != self._root_dev:
+                raise PathError("CROSS_DEVICE", show(s))
+        real = Path(os.path.realpath(cur))
+        if real == self.root or not real.is_relative_to(self.root):
+            raise PathError("ESCAPES_ROOT", show(str(real)))
+        if op in DESTRUCTIVE_OPS and real.is_dir():
+            inner = self._mount_inside(str(real))
+            if inner:
+                raise PathError("MOUNTPOINT_INSIDE", show(inner))
+        if op in WRITE_OPS and real.is_file() and os.lstat(real).st_nlink > 1:
+            raise PathError("HARDLINKED", show(str(real)))
+        return real
diff --git a/src/cora_sentinel/_vendor/subnetbus/gates.py b/src/cora_sentinel/_vendor/subnetbus/gates.py
new file mode 100644
index 0000000..c65aa77
--- /dev/null
+++ b/src/cora_sentinel/_vendor/subnetbus/gates.py
@@ -0,0 +1,152 @@
+"""Gate Invariants. Pure functions: (registry, task, action) -> GateResult. Fail closed.
+
+  GI_1  boundary    target, ref, subnet and every extra ref exist in the registry
+  GI_2  isolation   nothing leaves the declared subnet; paths contain no traversal
+  GI_3  safety      pre-commit AABB overlap guard + filesystem guard
+
+`task` is any mapping with str fields subnet, target, ref (a validated Mule block fits).
+`action` carries facts the HARNESS extracted. Never feed it raw model text.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Mapping, Optional, Tuple
+
+from .errors import BusError, PathError, show
+from .fsguard import PathGuard, lexical_segments
+from .geometry import AABB
+from .registry import Registry
+
+__all__ = ["Action", "GateResult", "Verdict", "gi_1", "gi_2", "gi_3", "check_all"]
+
+
+@dataclass(frozen=True)
+class Action:
+    refs: Tuple[str, ...] = ()                 # extra node names / IPs the operation touches
+    paths: Tuple[str, ...] = ()                # project-relative paths the operation touches
+    fs_op: Optional[str] = None                # read/write/delete/... applied to `paths`
+    proposed_bounds: Optional[AABB] = None     # where the target will be after the operation
+
+    def __post_init__(self):
+        object.__setattr__(self, "refs", tuple(self.refs))
+        object.__setattr__(self, "paths", tuple(self.paths))
+        if not all(type(r) is str for r in self.refs) or not all(type(p) is str for p in self.paths):
+            raise TypeError("refs and paths must be strings")
+        if self.proposed_bounds is not None and not isinstance(self.proposed_bounds, AABB):
+            raise TypeError("proposed_bounds must be an AABB")
+
+
+@dataclass(frozen=True)
+class GateResult:
+    """No __bool__ on purpose: `if verdict.failed:` must mean "something failed". Test `.ok`."""
+    gate: str
+    ok: bool
+    code: str = "OK"
+    detail: str = ""
+
+
+@dataclass(frozen=True)
+class Verdict:
+    ok: bool
+    results: Tuple[GateResult, ...]
+    revision: int
+
+    @property
+    def failed(self) -> Optional[GateResult]:
+        return next((r for r in self.results if not r.ok), None)
+
+    def still_valid(self, reg: Registry) -> bool:
+        """TOCTOU check: call right before committing. False if the registry changed."""
+        return self.ok and reg.revision == self.revision
+
+
+def _ok(g: str) -> GateResult:
+    return GateResult(g, True)
+
+
+def _no(g: str, code: str, detail: str = "") -> GateResult:
+    return GateResult(g, False, code, detail)
+
+
+def _fields(task: Any) -> Optional[Tuple[str, str, str]]:
+    if not isinstance(task, Mapping):
+        return None
+    vals = tuple(task.get(k) for k in ("subnet", "target", "ref"))
+    return vals if all(type(v) is str for v in vals) else None
+
+
+def gi_1(reg: Registry, task: Mapping, action: Action = Action()) -> GateResult:
+    f = _fields(task)
+    if f is None:
+        return _no("GI_1", "MALFORMED_TASK", "subnet, target and ref must be strings")
+    subnet, target, ref = f
+    if reg.subnet(subnet) is None:
+        return _no("GI_1", "UNKNOWN_SUBNET", show(subnet))
+    node = reg.get(target)
+    if node is None:
+        return _no("GI_1", "UNKNOWN_TARGET", show(target))
+    if node.ip != ref:
+        return _no("GI_1", "REF_MISMATCH", f"{target} is bound to {node.ip}, task says {show(ref)}")
+    for r in action.refs:
+        if reg.resolve(r) is None:
+            return _no("GI_1", "UNKNOWN_REF", show(r))
+    return _ok("GI_1")
+
+
+def gi_2(reg: Registry, task: Mapping, action: Action = Action()) -> GateResult:
+    f = _fields(task)
+    node = reg.get(f[1]) if f else None
+    if f is None or node is None:
+        return _no("GI_2", "UNRESOLVED_TASK", "run GI_1 first")
+    subnet = f[0]
+    if node.subnet != subnet:
+        return _no("GI_2", "CROSS_SUBNET_TARGET", f"{node.name} lives in {node.subnet}, task says {subnet}")
+    for r in action.refs:
+        other = reg.resolve(r)
+        if other is None:
+            return _no("GI_2", "UNRESOLVED_REF", show(r))
+        if other.subnet != subnet:
+            return _no("GI_2", "CROSS_SUBNET_REF", f"{other.name} lives in {other.subnet}")
+    for p in action.paths:
+        try:
+            lexical_segments(p)
+        except PathError as e:
+            return _no("GI_2", e.code, e.detail)
+    return _ok("GI_2")
+
+
+def gi_3(reg: Registry, task: Mapping, action: Action = Action(), *,
+         fs_guard: Optional[PathGuard] = None) -> GateResult:
+    f = _fields(task)
+    node = reg.get(f[1]) if f else None
+    if f is None or node is None:
+        return _no("GI_3", "UNRESOLVED_TASK", "run GI_1 first")
+    if action.proposed_bounds is not None:
+        problems = reg.placement_problems(node.subnet, action.proposed_bounds,
+                                          ignore=node.name, solid=node.solid)
+        if problems:
+            return _no("GI_3", problems[0][0], problems[0][1])
+    if action.paths:
+        if fs_guard is None:
+            return _no("GI_3", "NO_FS_GUARD", "paths supplied but no PathGuard configured")
+        if action.fs_op is None:
+            return _no("GI_3", "NO_FS_OP", "paths supplied without fs_op")
+        for p in action.paths:
+            try:
+                fs_guard.check(p, action.fs_op)
+            except BusError as e:
+                return _no("GI_3", e.code, e.detail)
+    return _ok("GI_3")
+
+
+def check_all(reg: Registry, task: Mapping, action: Optional[Action] = None, *,
+              fs_guard: Optional[PathGuard] = None, fail_fast: bool = True) -> Verdict:
+    action = action or Action()
+    results = []
+    for gate in (lambda: gi_1(reg, task, action), lambda: gi_2(reg, task, action),
+                 lambda: gi_3(reg, task, action, fs_guard=fs_guard)):
+        r = gate()
+        results.append(r)
+        if not r.ok and fail_fast:
+            break
+    return Verdict(all(r.ok for r in results), tuple(results), reg.revision)
