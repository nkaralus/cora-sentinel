@@ -0,0 +1,32 @@
+#!/bin/sh
+# postrm for cora-sentinel
+set -e
+
+case "$1" in
+    remove)
+        if [ -d /run/systemd/system ]; then
+            systemctl daemon-reload || true
+        fi
+        ;;
+    purge)
+        if [ -d /run/systemd/system ]; then
+            systemctl daemon-reload || true
+        fi
+        # state: the confirmed allow-set fingerprint, the dynamic-policy ledgers, violation reports
+        rm -rf /var/lib/cora-sentinel
+        # the conffiles themselves were already removed by dpkg; this only tidies an empty directory
+        rmdir --ignore-fail-on-non-empty /etc/cora-sentinel 2>/dev/null || true
+        # /var/log/cora-sentinel is KEPT on purpose: it is the audit trail (events, decisions)
+        if [ -d /var/log/cora-sentinel ]; then
+            echo "cora-sentinel: kept the audit logs in /var/log/cora-sentinel (delete them yourself if you want them gone)"
+        fi
+        ;;
+    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
+        ;;
+    *)
+        echo "postrm called with unknown argument '$1'" >&2
+        exit 1
+        ;;
+esac
+
+exit 0
