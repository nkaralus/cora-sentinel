#!/bin/sh
# postinst for cora-sentinel
set -e

case "$1" in
    configure)
        # The directories the shipped config's suggested --blocklist / --blocklist-allow flags point at must exist, or the daemon
        # exits at start with "[Errno 2] No such file or directory". dpkg ships them (each with an inert template); this puts them
        # back if an admin removed them. Two explicit paths: /bin/sh is dash, which has no brace expansion.
        mkdir -p /etc/cora-sentinel/blocklists /etc/cora-sentinel/allow
        # The shipped config publishes cora-tray's status feed to group cora (--ui-group cora), and the daemon refuses to
        # start if that group is missing. Created here; NOBODY is added: membership can press the tray's breakers (sever a
        # task's network, cap its memory), so it is granted by hand:  usermod -aG cora USER
        if ! getent group cora >/dev/null; then
            addgroup --system --quiet cora
        fi
        if command -v py3compile >/dev/null 2>&1; then
            py3compile -p cora-sentinel || true
        fi
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
            # An UPGRADE of a running service restarts onto the new code (a confirmed floor survives it, and an unchanged
            # allow set asks for no new confirmation). A fresh install is NEVER enabled or started here: the kernel floor
            # this daemon can install is host-wide, so the first start is the operator's decision.
            if [ -n "$2" ] && systemctl is-active --quiet cora-sentinel; then
                systemctl try-restart cora-sentinel || true
            fi
        fi
        if [ -z "$2" ]; then
            cat <<'MSG'
cora-sentinel is installed but NOT started (its kernel floor is host-wide, so the first start is yours to make):
  1. edit /etc/cora-sentinel/cora-sentinel.conf        (add --model ... and your blocklists)
  2. systemctl enable --now cora-sentinel
  3. cora-floor confirm                                 (within the --floor-confirm window, the first time)
  cora-tray (GNOME): usermod -aG cora YOUR_USER, log out and in; needs python3-gi and the Ayatana indicator
  (see /usr/share/doc/cora-sentinel/cora-tray.md)
Read /usr/share/doc/cora-sentinel/service.md and packaging.md first. Running a local model needs llama-cpp-python,
which this package does not bring: see packaging.md ("The model").
MSG
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
